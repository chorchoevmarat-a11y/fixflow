# Copy to .env to override defaults. Never commit a real .env.
POSTGRES_DB=fixflow
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=change-me-locally
DB_PORT=5432
API_PORT=8000
WEB_PORT=3000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_MINUTES=720
WEB_CONCURRENCY=4
# Set to 1 for the first start to load disposable demo data (idempotent).
SEED_ON_START=
# Browser-visible API address baked into the web build.
NEXT_PUBLIC_API_URL=http://localhost:8000
